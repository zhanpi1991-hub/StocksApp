# StocksApp configuration template. Placeholders only - never put real keys in this file.
#
# HOW TO USE:  copy this file to  .env  in the repository root (same folder as docker-compose.yml):
#     C:\Users\<you>\StocksApp\.env
# It is git-ignored. Keys are read by the BACKEND only. Restart the backend after any change.
# (backend/.env is also read and overrides the root file; real OS environment variables override both.)
# Do NOT wrap values in quotes or add spaces around "=".

# ---- Core ----
APP_ENV=development
# SQLite works with zero setup. For PostgreSQL: postgresql://stocks:stocks@localhost:5432/stocks
DATABASE_URL=sqlite:///./stocksapp.db
# Optional; shares the provider cache across processes
REDIS_URL=
# REQUIRED in production: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-development-only-0123456789abcdef
CORS_ORIGINS=http://localhost:5173

# ---- Market data provider keys (all optional; missing ones show an explained "unavailable" state) ----
# CoinGecko DEMO key (free): https://www.coingecko.com/en/api  -> sent as the x-cg-demo-api-key header
COINGECKO_API_KEY=
# Finnhub: https://finnhub.io/register
FINNHUB_API_KEY=
# Twelve Data: https://twelvedata.com/pricing  (free "Basic" plan)
TWELVE_DATA_API_KEY=
# Financial Modeling Prep: https://site.financialmodelingprep.com/developer/docs
FMP_API_KEY=

# ---- Request budgets (optional) ----
# Self-imposed ceilings that stop the app from hitting provider limits. 0 = automatic default.
# They are NOT the providers' official limits - raise them only if your plan allows it.
COINGECKO_REQUESTS_PER_MINUTE=0     # auto: 10 without a key, 25 with a Demo key
FINNHUB_REQUESTS_PER_MINUTE=0       # auto: 50
TWELVE_DATA_REQUESTS_PER_MINUTE=0   # auto: 7
TWELVE_DATA_REQUESTS_PER_DAY=0      # auto: 700
FMP_REQUESTS_PER_DAY=0              # auto: 225
# Seconds crypto market data is served from the server cache before refreshing
CRYPTO_MARKETS_TTL=120

# ---- Production only (see docs/DEPLOYMENT.md) ----
# With APP_ENV=production the app REFUSES TO START unless: JWT_SECRET is random and 32+ chars, DATABASE_URL is PostgreSQL,
# and CORS_ORIGINS lists your real frontend origin(s) (no "*", no trailing slash).
# Optional regex for Vercel preview URLs:  CORS_ORIGIN_REGEX=https://stocksapp-[a-z0-9-]+\.vercel\.app
CORS_ORIGIN_REGEX=
# /docs is disabled in production unless ENABLE_DOCS=true
# ENABLE_DOCS=true
AUTH_RATE_LIMIT_PER_MINUTE=10

# ---- Misc ----
# Local development only: labelled static SAMPLE data for a few symbols when keys are missing. Ignored in production.
DEMO_MODE=false
ALERT_INTERVAL_SECONDS=60
RATE_LIMIT_PER_MINUTE=240

# ---- Frontend (frontend/.env.local; only if the API is on another origin, e.g. Vercel). Never put provider keys here. ----
# VITE_API_URL=https://your-backend.example.com/api
# VITE_WS_URL=wss://your-backend.example.com/api/ws
